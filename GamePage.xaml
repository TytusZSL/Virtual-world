<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Virtual_world.GamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:wrld="clr-namespace:Virtual_world.GameWorld.Graphics"
    x:DataType="wrld:DisplayWorld">

    <VerticalStackLayout Padding="30,0" Spacing="25">
        <CollectionView
            BackgroundColor="Gray"
            ItemsSource="{Binding Tiles}"
            WidthRequest="{Binding ExpectedWorldWidth}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Stroke="Black"
                        StrokeShape="Rectangle"
                        StrokeThickness="2">
                        <Image
                            HeightRequest="50"
                            Source="{Binding GraphicSrc}"
                            WidthRequest="50" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="{Binding WorldWidth}" />
            </CollectionView.ItemsLayout>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>
