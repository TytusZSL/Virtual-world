<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Virtual_world.GamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:wrld="clr-namespace:Virtual_world.GameWorld.Graphics"
    x:DataType="wrld:DisplayWorld">

    <ScrollView
        BackgroundColor="Gray"
        Orientation="Both">
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TileRows}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="x:Object">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding .}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="wrld:DisplayableTile">
                                <Border
                                    HeightRequest="54"
                                    Stroke="Black"
                                    StrokeShape="Rectangle"
                                    StrokeThickness="2"
                                    WidthRequest="54">
                                    <Image
                                        HeightRequest="50"
                                        Source="{Binding GraphicSrc}"
                                        WidthRequest="50" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
